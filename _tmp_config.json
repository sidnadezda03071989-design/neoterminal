 "50": "REPLAY_LIMIT = 20000",
 "51": "# Потолок свечей для бэктеста: 5m × 30 дней = ~8600 баров, 20 страниц Binance",
 "52": "# через прокси рвутся и копят retry (3-5 мин). 5000 баров ≈ 17 дней по 5m —",
 "53": "# быстрее и без обрывов; больше можно запросить селектом #bt-limit в панели.",
 "54": "BACKTEST_LIMIT = 5000",
 "55": "",
 "56": "# --------------------------------------------- grid-search сканер стратегий",
 "57": "# Лимит комбинаций параметров на один запуск сканера. Если декартово",
 "58": "# произведение грида больше — берётся случайная подвыборка (seed=42,",
 "59": "# воспроизводимый набор при одинаковом гриде), см. app_pkg/ai/scanner.py.",
 "60": "# 5000 -> 50000: масштабный прогон на несколько часов — 10 символов × 6 ТФ ×",
 "61": "# 12 стратегий (402 комбинации на символ/ТФ) = 24 120, плюс запас на",
 "62": "# кастомные гриды (10 символов × 402 × запас).",
 "63": "SCAN_MAX_COMBINATIONS = 50000",
 "64": "# Число потоков ThreadPoolExecutor для параллельного прогона бэктестов.",
 "65": "SCAN_WORKERS = 8",
 "66": "# --- оценка длительности прогона (ответ POST /api/scan, подсказка в UI) ---",
 "67": "# Средняя длительность одного бэктеста комбинации (сек) и фетча данных на",
 "68": "# один символ (сек). Оценка: combos × sec_combo / SCAN_WORKERS + symbols × 15.",
 "69": "SCAN_SECONDS_PER_COMBINATION = 0.3",
 "70": "SCAN_FETCH_SECONDS_PER_SYMBOL = 15.0",
 "71": "# Прогон дольше 30 минут -> warning в ответе POST /api/scan (UI: жёлтый",
 "72": "# блок + confirm перед запуском). 3600 -> 1800: длинные прогоны стали",
 "73": "# реальной ситуацией, предупреждать нужно раньше.",
 "74": "SCAN_WARN_SECONDS = 1800",
 "75": "# Жёсткий потолок длительности прогона: оценка больше 4 часов -> 400",
 "76": "# (скан не стартует, объём надо сократить или запускать по частям).",
 "77": "SCAN_HARD_LIMIT_SECONDS = 14400",
 "78": "# Каждые N обработанных комбинаций SSE-событие scan_progress шлёт eta_seconds.",
 "79": "SCAN_ETA_PUSH_EVERY = 10",
 "80": "# Доля истории на train; остаток (30%) — out-of-sample test.",
 "81": "SCAN_TRAIN_SPLIT = 0.7",
 "82": "# Глубина истории скана в днях от текущего момента (1 год вместо 2):",
 "83": "# 730 дней давали 20k+ свечей и ~40 сек фетча на символ.",
 "84": "SCAN_PERIOD_DAYS = 365",
 "85": "# Потолок свечей на символ в сканере: 5000 вместо 20000 (REPLAY_LIMIT) —",
 "86": "# ×4 меньше данных на фетч и на каждый бэктест комбинации.",
 "87": "SCAN_REPLAY_LIMIT = 5000",
 "88": "# Минимум сделок хотя бы на одном из окон (train/test): комбинации с",
 "89": "# меньшим числом отбрасываются («повезло на 3 сделках» не проходит).",
 "90": "SCAN_MIN_TRADES = 30",
 "91": "# Сколько лучших комбинаций возвращает GET /api/scan/<run_id>.",
 "92": "SCAN_TOP_N = 20",
 "93": "# Общий грид Bollinger-стратегий (bb_reversal / bb_breakout): 4 × 3 = 12.",
 "94": "_BB_GRID = {\"period\": [15, 20, 25, 30], \"std\": [1.5, 2.0, 2.5]}",
 "95": "",
 "96": "# Сетки параметров по стратегиям (ключи = ключи STRATEGY_MAP в",
 "97": "# app_pkg/ai/backtest.py). Число комбинаций стратегии — в комментарии,",
 "98": "# сумма по всем 12 стратегиям = 402 на символ и один ТФ.",
 "99": "SCAN_GRIDS = {",
 "100": "    \"sma_cross\": {",
 "101": "        \"fast\": [5, 8, 10, 12, 15, 20, 25, 30, 40, 50],",
 "102": "        \"slow\": [20, 30, 40, 50, 60, 80, 100, 150, 200]",
 "103": "    },",
 "104": "    \"rsi_reversal\": {",
 "105": "        \"period\": [7, 10, 14, 18, 21],",
 "106": "        \"oversold\": [20, 25, 30, 35],",
 "107": "        \"overbought\": [65, 70, 75, 80]",
 "108": "    },",
 "109": "    \"macd_cross\": {",
 "110": "        \"fast\": [8, 10, 12, 15],",
 "111": "        \"slow\": [20, 24, 26, 30],",
 "112": "        \"signal\": [5, 7, 9, 12]",
 "113": "    },",
 "114": "    \"ema_cross\": {                          # 5 × 5 = 25",
 "115": "        \"fast\": [8, 10, 12, 15, 20],",
 "116": "        \"slow\": [20, 26, 30, 40, 50]",
 "117": "    },",
 "118": "    \"bb_reversal\": dict(_BB_GRID),          # 4 × 3 = 12",
 "119": "    \"bb_breakout\": dict(_BB_GRID),          # 4 × 3 = 12 (тот же грид)",
 "120": "    \"supertrend\": {                         # 4 × 4 = 16",
 "121": "        \"period\": [7, 10, 14, 20],",
 "122": "        \"multiplier\": [2.0, 2.5, 3.0, 3.5]",
 "123": "    },",
 "124": "    \"stoch_reversal\": {                     # 3 × 2 × 3 × 3 = 54",
 "125": "        \"k_period\": [10, 14, 21],",
 "126": "        \"d_period\": [3, 5],",
 "127": "        \"oversold\": [15, 20, 25],",
 "128": "        \"overbought\": [75, 80, 85]",
 "129": "    },",
 "130": "    \"stoch_cross\": {                        # 3 × 2 = 6",
 "131": "        \"k_period\": [10, 14, 21],",
 "132": "        \"d_period\": [3, 5]",
 "133": "    },",
 "134": "    \"cci_reversal\": {                       # 3 × 3 × 3 = 27",
 "135": "        \"period\": [14, 20, 30],",
 "136": "        \"oversold\": [-150, -100, -80],      # свои зоны CCI (не 0..100)",
 "137": "        \"overbought\": [80, 100, 150]",
 "138": "    },",
 "139": "    \"vwap_reversal\": {                      # 4",
 "140": "        \"vwap_threshold\": [0.003, 0.005, 0.008, 0.012]  # доля отклонения",
 "141": "    },",
 "142": "    \"adx_trend\": {                          # 3 × 4 = 12",
 "143": "        \"period\": [10, 14, 21],",
 "144": "        \"adx_threshold\": [20, 25, 30, 35]   # порог силы тренда",
 "145": "    }",
 "146": "}",
 "147": "# Доступные стратегии сканера: человекочитаемая метка, список параметров и",
 "148": "# дефолтный грид (custom_grids из POST /api/scan мержатся поверх дефолта).",
 "149": "SCAN_ALLOWED_STRATEGIES = {",
 "150": "    \"sma_cross\": {",
 "151": "        \"label\": \"SMA Cross\",",
 "152": "        \"params\": [\"fast\", \"slow\"],",
 "153": "        \"default_grid\": SCAN_GRIDS[\"sma_cross\"],",
 "154": "    },",
 "155": "    \"rsi_reversal\": {",
 "156": "        \"label\": \"RSI Reversal\",",
 "157": "        \"params\": [\"period\", \"oversold\", \"overbought\"],",
 "158": "        \"default_grid\": SCAN_GRIDS[\"rsi_reversal\"],",
 "159": "    },",
 "160": "    \"macd_cross\": {",
 "161": "        \"label\": \"MACD\",",
 "162": "        \"params\": [\"fast\", \"slow\", \"signal\"],",
 "163": "        \"default_grid\": SCAN_GRIDS[\"macd_cross\"],",
 "164": "    },",
 "165": "    \"ema_cross\": {",
 "166": "        \"label\": \"EMA Cross\",",
 "167": "        \"params\": [\"fast\", \"slow\"],",
 "168": "        \"default_grid\": SCAN_GRIDS[\"ema_cross\"],",
 "169": "    },",
 "170": "    \"bb_reversal\": {",
 "171": "        \"label\": \"BB Reversal\",",
 "172": "        \"params\": [\"period\", \"std\"],",
 "173": "        \"default_grid\": SCAN_GRIDS[\"bb_reversal\"],",
 "174": "    },",
 "175": "    \"bb_breakout\": {",
 "176": "        \"label\": \"BB Breakout\",",
 "177": "        \"params\": [\"period\", \"std\"],",
 "178": "        \"default_grid\": SCAN_GRIDS[\"bb_breakout\"],",
 "179": "    },",
 "180": "    \"supertrend\": {",
 "181": "        \"label\": \"Supertrend Follow\",",
 "182": "        \"params\": [\"period\", \"multiplier\"],",
 "183": "        \"default_grid\": SCAN_GRIDS[\"supertrend\"],",
 "184": "    },",
 "185": "    \"stoch_reversal\": {",
 "186": "        \"label\": \"Stoch Reversal\",",
 "187": "        \"params\": [\"k_period\", \"d_period\", \"oversold\", \"overbought\"],",
 "188": "        \"default_grid\": SCAN_GRIDS[\"stoch_reversal\"],",
 "189": "    },",
 "190": "    \"stoch_cross\": {",
 "191": "        \"label\": \"Stoch Cross\",",
 "192": "        \"params\": [\"k_period\", \"d_period\"],",
 "193": "        \"default_grid\": SCAN_GRIDS[\"stoch_cross\"],",
 "194": "    },",
 "195": "    \"cci_reversal\": {",
 "196": "        \"label\": \"CCI Reversal\",",
 "197": "        \"params\": [\"period\", \"oversold\", \"overbought\"],",
 "198": "        \"default_grid\": SCAN_GRIDS[\"cci_reversal\"],",
 "199": "    },",
 "200": "    \"vwap_reversal\": {",
 "201": "        \"label\": \"VWAP Reversal\",",
 "202": "        \"params\": [\"vwap_threshold\"],",
 "203": "        \"default_grid\": SCAN_GRIDS[\"vwap_reversal\"],",
 "204": "    },",
 "205": "    \"adx_trend\": {",
 "206": "        \"label\": \"ADX Trend\",",
 "207": "        \"params\": [\"period\", \"adx_threshold\"],",
 "208": "        \"default_grid\": SCAN_GRIDS[\"adx_trend\"],",
 "209": "    },",
 "210": "}",
 "211": "# Разумные пределы значений параметров (валидация custom_grids). Границы",
 "212": "# с плавающей точкой (std / multiplier / vwap_threshold) разрешают дробные",
 "213": "# значения — см. app_pkg/routes/scanner.py::_validate_custom_grids.",
 "214": "SCAN_PARAM_LIMITS = {",
 "215": "    \"fast\": (2, 200),",
 "216": "    \"slow\": (2, 300),",
 "217": "    \"signal\": (2, 50),",
 "218": "    \"period\": (2, 50),",
 "219": "    # oversold/overbought общие для RSI/Stoch (5..50 / 50..95) и CCI",
 "220": "    # (-150..-80 / 80..150) — границы расширены под оба случая.",
 "221": "    \"oversold\": (-200, 50),",
 "222": "    \"overbought\": (50, 200),",
 "223": "    \"std\": (0.5, 4.0),              # Bollinger: ширина канала в σ",
 "224": "    \"multiplier\": (1.0, 5.0),       # Supertrend: множитель ATR",
 "225": "    \"k_period\": (5, 30),            # Stoch: период %K",
 "226": "    \"d_period\": (2, 10),            # Stoch: период %D",
 "227": "    \"adx_threshold\": (10, 50),      # ADX Trend: порог силы тренда",
 "228": "    \"vwap_threshold\": (0.001, 0.05),  # VWAP: доля отклонения от VWAP",
 "229": "}",
 "230": "# Максимум значений в одном параметре custom grid (20 -> 30: расширенные",
 "231": "# гриды новых стратегий, напр. stoch_reversal 3×3×3).",
 "232": "SCAN_MAX_CUSTOM_VALUES = 30",
 "233": "# Таймфреймы сканера (5m добавлен первым). Один прогон может идти по",
 "234": "# НЕСКОЛЬКИМ ТФ сразу (body.timeframes в POST /api/scan): объём считается",
 "235": "# как symbols × timeframes × Σ combos, поэтому лимит SCAN_MAX_COMBINATIONS",
 "236": "# расходуется быстрее — см. app_pkg/ai/scanner.py::plan_totals.",
 "237": "SCAN_TIMEFRAMES = [\"5m\", \"15m\", \"1H\", \"4H\", \"1D\"]",
 "238": "# ТФ по умолчанию в UI сканера (чекбоксы #scan-timeframes):",
 "239": "# отдаётся фронту в GET /api/scan/grids как default_timeframes.",
 "240": "SCAN_DEFAULT_TIMEFRAMES = [\"15m\", \"1H\"]",
