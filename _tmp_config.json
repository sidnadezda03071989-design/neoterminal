 "302": "# ------------------------------------------------------------ DeepSeek",
 "303": "# Основной LLM-провайдер: DeepSeek через aitunnel.ru (OpenAI-совместимый",
 "304": "# API). POST {DEEPSEEK_BASE_URL}/chat/completions, GET .../models,",
 "305": "# Authorization: Bearer sk-aitunnel-...",
 "306": "# base_url проверен вручную: https://api.aitunnel.ru/v1 -> HTTP 200",
 "307": "# (310 моделей, включая deepseek-v4-flash и deepseek-v4-flash-vision-exp).",
 "308": "DEEPSEEK_API_KEY = os.getenv(\"DEEPSEEK_API_KEY\") or \"\"",
 "309": "DEEPSEEK_BASE_URL = os.getenv(\"DEEPSEEK_BASE_URL\",",
 "310": "                              \"https://api.aitunnel.ru/v1\")",
