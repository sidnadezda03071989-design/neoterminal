 "246": "DRAWINGS_FILE = DATA_DIR / \"drawings.json\"  # legacy: файловое хранилище (не используется)",
 "247": "CHAT_FILE = DATA_DIR / \"chat.json\"          # legacy: файловое хранилище (не используется)",
 "248": "",
