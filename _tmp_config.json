 "369": "# ------------------------------------------------ fallback-цепочка провайдеров",
 "370": "# Порядок опроса в app_pkg/ai/llm.py: qwen -> groq -> deepseek. Первый",
 "371": "# провайдер с непустым ключом используется; при 401/403/404 или сетевом",
 "372": "# сбое запрос уходит к следующему. Переопределяется env LLM_PROVIDER_ORDER",
 "373": "# (имена через запятую). Неизвестные имена пропускаются с warning.",
 "374": "LLM_PROVIDER_ORDER = [",
 "375": "    p.strip() for p in os.getenv(\"LLM_PROVIDER_ORDER\",",
 "376": "                                 \"qwen,groq,deepseek\").split(\",\")",
 "377": "    if p.strip()",
 "378": "]",
 "379": "",
 "380": "",
 "381": "def llm_enabled() -> bool:",
 "382": "    \"\"\"True, если настроен хотя бы один провайдер fallback-цепочки.\"\"\"",
 "383": "    return bool(",
 "384": "        (QWEN_API_KEY_1 and QWEN_BASE_URL_1 and QWEN_MODEL_1)",
 "385": "        or (GROQ_API_KEY and GROQ_BASE_URL and GROQ_MODEL)",
 "386": "        or (DEEPSEEK_API_KEY and DEEPSEEK_BASE_URL and DEEPSEEK_MODEL)",
 "387": "    )",
 "388": "",
 "389": "",
 "390": "def deepseek_enabled() -> bool:",
 "391": "    \"\"\"Алиас llm_enabled() (совместимость: раньше основной был DeepSeek).\"\"\"",
 "392": "    return llm_enabled()",
 "393": "",
 "394": "",
 "395": "def any_llm_enabled() -> bool:",
 "396": "    \"\"\"Алиас llm_enabled(): настроен хотя бы один из трёх провайдеров.\"\"\"",
 "397": "    return llm_enabled()",
 "398": "",
 "399": "",
 "400": "def qwen_enabled() -> bool:",
 "401": "    \"\"\"Legacy-алиас llm_enabled() (старые вызовы не ломаем).\"\"\"",
 "402": "    return llm_enabled()",
 "403": "",
 "404": "",
 "405": "def openrouter_enabled() -> bool:",
 "406": "    \"\"\"Legacy-алиас llm_enabled() (старые вызовы не ломаем).\"\"\"",
 "407": "    return llm_enabled()",
