 "312": "DEEPSEEK_MODEL_2 = os.getenv(\"DEEPSEEK_MODEL_2\", \"deepseek-v4-flash\")",
 "313": "DEEPSEEK_VISION_MODEL = os.getenv(\"DEEPSEEK_VISION_MODEL\",",
 "314": "                                  \"deepseek-v4-flash-vision-exp\")",
 "315": "DEEPSEEK_TIMEOUT = float(os.getenv(\"DEEPSEEK_TIMEOUT\", \"120\"))",
 "316": "DEEPSEEK_MAX_TOKENS = int(os.getenv(\"DEEPSEEK_MAX_TOKENS\", \"2000\"))",
 "317": "",
 "318": "# ------------------------------------------------------- Groq (fallback)",
 "319": "# Резервный провайдер: включается ТОЛЬКО если DeepSeek вернул 401/403/404",
 "320": "# (см. app_pkg/ai/llm.py). По умолчанию не используется.",
 "321": "# OpenAI-совместимый API, заголовок Authorization: Bearer gsk_...",
 "322": "GROQ_API_KEY = os.getenv(\"GROQ_API_KEY\") or \"\"",
 "323": "GROQ_BASE_URL = os.getenv(\"GROQ_BASE_URL\", \"https://api.groq.com/openai/v1\")",
 "324": "GROQ_MODEL = os.getenv(\"GROQ_MODEL\", \"llama-3.3-70b-versatile\")",
 "325": "GROQ_MODEL_2 = os.getenv(\"GROQ_MODEL_2\", \"llama-3.1-8b-instant\")",
 "326": "# Актуальный список моделей: GET https://api.groq.com/openai/v1/models.",
 "327": "# (llama-3.2-90b-vision-preview мог быть снят с производства — тогда",
 "328": "# vision штатно уходит в fallback на текстовый анализ.)",
 "329": "GROQ_VISION_MODEL = os.getenv(\"GROQ_VISION_MODEL\",",
 "330": "                              \"llama-3.2-90b-vision-preview\")",
 "331": "GROQ_TIMEOUT = float(os.getenv(\"GROQ_TIMEOUT\", \"120\"))",
 "332": "GROQ_MAX_TOKENS = int(os.getenv(\"GROQ_MAX_TOKENS\", \"2000\"))",
 "333": "# Режим анализа: 0/1 — один агент, 2 — два агента (Price + Indicators).",
 "334": "GROQ_AGENT_MODE = int(os.getenv(\"GROQ_AGENT_MODE\",",
 "335": "                                os.getenv(\"QWEN_AGENT_MODE\", \"0\")))",
 "336": "VISION_ENABLED = os.getenv(\"VISION_ENABLED\", \"1\") == \"1\"",
 "337": "",
 "338": "# ------------------------------------------------- Qwen / DashScope (Qwen)",
 "339": "# OpenAI-совместимый режим Aliyun DashScope. Ключ проверен вручную:",
 "340": "# GET {base}/models -> HTTP 200 (169 моделей). ВАЖНО: qwen-flash отдаёт",
 "341": "# HTTP 403 AllocationQuota.FreeTierOnly (free-tier квота исчерпана),",
 "342": "# поэтому рабочий дефолт — qwen-plus. Диагностика: check_qwen_key.py.",
 "343": "QWEN_API_KEY_1 = (os.getenv(\"QWEN_API_KEY_1\")",
 "344": "                  or os.getenv(\"QWEN_API_KEY\") or \"\")",
 "345": "QWEN_API_KEY_2 = os.getenv(\"QWEN_API_KEY_2\") or QWEN_API_KEY_1",
 "346": "QWEN_BASE_URL_1 = (os.getenv(\"QWEN_BASE_URL_1\")",
 "347": "                   or os.getenv(\"QWEN_BASE_URL\")",
 "348": "                   or \"https://dashscope-intl.aliyuncs.com/compatible-mode/v1\")",
 "349": "QWEN_BASE_URL = QWEN_BASE_URL_1  # legacy-имя",
 "350": "QWEN_BASE_URL_2 = os.getenv(\"QWEN_BASE_URL_2\") or QWEN_BASE_URL_1",
 "351": "QWEN_MODEL_1 = (os.getenv(\"QWEN_MODEL_1\")",
 "352": "                or os.getenv(\"QWEN_MODEL\") or \"qwen-plus\")",
 "353": "QWEN_MODEL = QWEN_MODEL_1  # legacy-имя",
 "354": "QWEN_MODEL_2 = os.getenv(\"QWEN_MODEL_2\") or QWEN_MODEL_1",
 "355": "QWEN_VL_MODEL = os.getenv(\"QWEN_VL_MODEL\") or \"qwen-vl-max\"",
 "356": "QWEN_TIMEOUT = float(os.getenv(\"QWEN_TIMEOUT\", \"120\"))",
 "357": "QWEN_TIMEOUT_2 = float(os.getenv(\"QWEN_TIMEOUT_2\", str(QWEN_TIMEOUT)))",
 "358": "QWEN_MAX_TOKENS = int(os.getenv(\"QWEN_MAX_TOKENS\", \"2000\"))",
 "359": "QWEN_AGENT_MODE = GROQ_AGENT_MODE",
 "360": "",
 "361": "OPENROUTER_API_KEY = GROQ_API_KEY",
 "362": "OPENROUTER_BASE_URL = GROQ_BASE_URL",
 "363": "OPENROUTER_MODEL = GROQ_MODEL",
 "364": "OPENROUTER_VISION_MODEL = GROQ_VISION_MODEL",
 "365": "OPENROUTER_AGENT_MODE = GROQ_AGENT_MODE",
