# --- DeepSeek через aitunnel.ru (ОСНОВНОЙ LLM-провайдер) ---
# base_url проверен: GET https://api.aitunnel.ru/v1/models -> HTTP 200
DEEPSEEK_API_KEY=sk-aitunnel-your-key-here
DEEPSEEK_BASE_URL=https://api.aitunnel.ru/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_2=deepseek-v4-flash
# Vision-модель (есть в списке aitunnel: deepseek-v4-flash-vision-exp).
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=2000

# --- Groq (FALLBACK: только если DeepSeek вернул 401/403/404) ---
# Ключ формата gsk_... Актуальные модели: GET {GROQ_BASE_URL}/models
GROQ_API_KEY=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Быстрая модель (второй агент / короткие задачи).
GROQ_MODEL_2=llama-3.1-8b-instant
# Vision-модель. Если Groq не принимает images (проверка: GET /models) —
# AI Analysis штатно уйдёт в fallback на текстовый анализ.
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
GROQ_TIMEOUT=120
GROQ_MAX_TOKENS=2000

# --- Legacy OpenRouter (не используется, оставлен для совместимости) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stealth/union-alpha
# Если stealth/union-alpha не поддерживает images (проверка: GET /models,
# architecture.input_modalities) — укажите vision-модель с поддержкой image,
# например qwen/qwen-2.5-vl-72b-instruct или google/gemini-2.0-flash-exp:free
OPENROUTER_VISION_MODEL=stealth/union-alpha
OPENROUTER_AGENT_MODE=2
VISION_ENABLED=1

MT5_PATH=C:\Users\Public\OneDrive\Рабочий стол\MetaTrader 5\terminal64.exe
MT5_AUTOSTART=1
MT5_START_TIMEOUT=30
