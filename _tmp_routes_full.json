 "31": "# ------------------------------------------------------------- verdict/label",
 "32": "# Формат подписи комбинации: strategy_id -> (ожидаемые ключи params, шаблон).",
 "33": "# Если params содержат ключи вне ожидаемого набора — подпись уходит в",
 "34": "# fallback «strategy_id key=val,...» (см. _strategy_label).",
 "35": "_LABEL_FORMATS = {",
 "36": "    \"sma_cross\": ((\"fast\", \"slow\"), \"{fast}/{slow}\"),",
 "37": "    \"macd_cross\": ((\"fast\", \"slow\", \"signal\"), \"{fast}-{signal}-{slow}\"),",
 "38": "    \"rsi_reversal\": ((\"period\", \"oversold\", \"overbought\"),",
 "39": "                     \"{period}/{oversold}/{overbought}\"),",
 "40": "    \"ema_cross\": ((\"fast\", \"slow\"), \"{fast}/{slow}\"),",
 "41": "    \"bb_reversal\": ((\"period\", \"std\"), \"{period}/{std}\"),",
 "42": "    \"bb_breakout\": ((\"period\", \"std\"), \"{period}/{std}\"),",
 "43": "    \"supertrend\": ((\"period\", \"multiplier\"), \"{period}-{multiplier}\"),",
 "44": "    \"stoch_reversal\": ((\"k_period\", \"d_period\", \"oversold\", \"overbought\"),",
 "45": "                       \"{k_period}/{d_period}/{oversold}/{overbought}\"),",
 "46": "    \"stoch_cross\": ((\"k_period\", \"d_period\"), \"{k_period}/{d_period}\"),",
 "47": "    \"cci_reversal\": ((\"period\", \"oversold\", \"overbought\"),",
 "48": "                     \"{period}/{oversold}/{overbought}\"),",
 "49": "    \"vwap_reversal\": ((\"vwap_threshold\",), \"{vwap_threshold}\"),",
 "50": "    \"adx_trend\": ((\"period\", \"adx_threshold\"), \"{period}/{adx_threshold}\"),",
 "51": "}",
 "52": "",
 "53": "",
 "54": "def _strategy_label(result):",
 "55": "    \"\"\"Человекочитаемое название: 'SMA Cross 15/26', 'Supertrend 10-3.0'.",
 "56": "",
 "57": "    Порядок: params без незнакомых ключей форматируются шаблоном стратегии",
 "58": "    (отсутствующие значения -> '?'); при незнакомых ключах — fallback",
 "59": "    'strategy_id key1=val1,key2=val2', чтобы в UI ничего не потерялось.",
 "60": "    \"\"\"",
 "61": "    sid = str(result.get(\"strategy\") or \"\")",
 "62": "    meta = config.SCAN_ALLOWED_STRATEGIES.get(sid) or {}",
 "63": "    label = meta.get(\"label\", sid)",
 "64": "    p = result.get(\"params\") or {}",
 "65": "    spec = _LABEL_FORMATS.get(sid)",
 "66": "    if spec:",
 "67": "        keys, fmt = spec",
 "68": "        if set(p) <= set(keys):",
 "69": "            values = {k: p.get(k, \"?\") for k in keys}",
 "70": "            return f\"{label} \" + fmt.format(**values)",
 "71": "    if p:",
 "72": "        kv = \", \".join(f\"{k}={p[k]}\" for k in sorted(p))",
 "73": "        return f\"{sid or '?'} {kv}\"",
 "74": "    return label or sid",
 "75": "",
 "76": "",
 "77": "def _verdict(result):",
 "78": "    \"\"\"Verdict комбинации: (verdict, verdict_text, quality).",
 "79": "",
 "80": "    Порядок проверок важен: сначала грубые проблемы (losing/overfit/noise),",
 "81": "    потом оценка стабильности по combined_sharpe.",
 "82": "    \"\"\"",
 "83": "    train = result.get(\"train\") or {}",
 "84": "    test = result.get(\"test\") or {}",
 "85": "    train_sharpe = float(train.get(\"sharpe\") or 0)",
 "86": "    test_sharpe = float(test.get(\"sharpe\") or 0)",
 "87": "    combined = float(result.get(\"combined_sharpe\") or 0)",
 "88": "    trades = int(test.get(\"trades\") or 0)",
 "89": "    if test_sharpe <= -0.1:",
 "90": "        return \"losing\", \"Убыточна на новых данных\", \"poor\"",
 "91": "    if train_sharpe - test_sharpe > 0.4:",
 "92": "        return \"overfit\", \"Переоптимизация (train >> test)\", \"poor\"",
 "93": "    if trades < 50:",
 "94": "        return \"noise\", \"Мало сделок (< 50) — недостаточно данных\", \"fair\"",
 "95": "    if combined >= 0.5:",
 "96": "        quality = \"excellent\" if combined >= 1.0 else \"good\"",
 "97": "        return \"stable\", \"Стабильна и на train, и на test\", quality",
 "98": "    if combined >= 0.2:",
 "99": "        return \"stable\", \"Работает умеренно\", \"fair\"",
 "100": "    return \"weak\", \"Слабый edge\", \"poor\"",
 "101": "",
 "102": "",
 "103": "def _annotate(result):",
 "104": "    \"\"\"Копия результата + verdict/verdict_text/quality/strategy_label.\"\"\"",
 "105": "    r = dict(result)",
 "106": "    r[\"verdict\"], r[\"verdict_text\"], r[\"quality\"] = _verdict(r)",
 "107": "    r[\"strategy_label\"] = _strategy_label(r)",
 "108": "    return r",
 "109": "",
 "110": "",
 "111": "# --------------------------------------------------------------- custom grids",
 "112": "def _validate_custom_grids(custom_grids):",
 "113": "    \"\"\"Валидация custom_grids -> (merged_grids, None) | (None, error_text).",
 "114": "",
 "115": "    Каждый указанный параметр мержится ПОВЕРХ дефолтного грида: параметры,",
 "116": "    которых нет в custom grid, берутся из SCAN_GRIDS. Проверяем: стратегия",
 "117": "    в SCAN_ALLOWED_STRATEGIES, параметр в allowed list, значения — int в",
 "118": "    разумных пределах, 1..SCAN_MAX_CUSTOM_VALUES значений на параметр,",
 "119": "    общее число комбинаций ≤ SCAN_MAX_COMBINATIONS (та же формулировка",
 "120": "    ошибки, что и в api_scan_start — см. «Too many combinations»).",
 "121": "    \"\"\"",
 "122": "    if not isinstance(custom_grids, dict) or not custom_grids:",
 "123": "        return None, (\"custom_grids должен быть непустым объектом \"",
 "124": "                      \"{стратегия: {param: [значения]}}\")",
 "125": "    grids = {}",
 "126": "    total = 0",
 "127": "    for sid, grid in custom_grids.items():",
 "128": "        meta = config.SCAN_ALLOWED_STRATEGIES.get(sid)",
 "129": "        if not meta:",
 "130": "            return None, f\"Неизвестная стратегия: {sid}\"",
 "131": "        if not isinstance(grid, dict) or not grid:",
 "132": "            return None, f\"{sid}: грид должен быть непустым объектом\"",
 "133": "        clean = {}",
 "134": "        for pname, values in grid.items():",
 "135": "            if pname not in meta[\"params\"]:",
 "136": "                return None, (f\"{sid}: параметр '{pname}' не разрешён \"",
 "137": "                              f\"(разрешены: {', '.join(meta['params'])})\")",
 "138": "            if not isinstance(values, list):",
 "139": "                return None, f\"{sid}.{pname}: нужен список значений\"",
 "140": "            if not 1 <= len(values) <= config.SCAN_MAX_CUSTOM_VALUES:",
 "141": "                return None, (f\"{sid}.{pname}: от 1 до \"",
 "142": "                              f\"{config.SCAN_MAX_CUSTOM_VALUES} значений, \"",
 "143": "                              f\"получено {len(values)}\")",
 "144": "            lo, hi = config.SCAN_PARAM_LIMITS.get(pname, (2, 300))",
 "145": "            # Границы с плавающей точкой (std / multiplier / vwap_threshold)",
 "146": "            # разрешают дробные значения, остальные параметры — только int.",
 "147": "            float_ok = any(isinstance(b, float) for b in (lo, hi))",
 "148": "            clean_values = []",
 "149": "            for v in values:",
 "150": "                if isinstance(v, bool) or not isinstance(v, (int, float)) \\",
 "151": "                        or (not float_ok and not isinstance(v, int)) \\",
 "152": "                        or not lo <= v <= hi:",
 "153": "                    kind = \"число\" if float_ok else \"целое\"",
 "154": "                    return None, (f\"{sid}.{pname}: значение {v!r} — \"",
 "155": "                                  f\"нужно {kind} в диапазоне {lo}–{hi}\")",
 "156": "                clean_values.append(v)",
 "157": "            clean[pname] = clean_values",
 "158": "        merged = {**(config.SCAN_GRIDS.get(sid) or {}), **clean}",
 "159": "        combos = 1",
 "160": "        for vals in merged.values():",
 "161": "            combos *= len(vals)",
 "162": "        total += combos",
 "163": "        grids[sid] = merged",
 "164": "    if total > config.SCAN_MAX_COMBINATIONS:",
 "165": "        # Тот же текст, что и в api_scan_start (проверка по символам):",
 "166": "        # дешёвая проверка произведения длин ДО материализации комбинаций.",
 "167": "        return None, (f\"Too many combinations: {total} > \"",
 "168": "                      f\"{config.SCAN_MAX_COMBINATIONS}. Сократите \"",
 "169": "                      f\"символы, ТФ или стратегии.\")",
 "170": "    return grids, None",
 "171": "",
 "172": "",
 "173": "def _human_seconds(seconds):",
 "174": "    \"\"\"Секунды -> '45 сек' / '12 мин' / '2 ч 15 мин' (для warning и UI).\"\"\"",
 "175": "    seconds = int(seconds)",
 "176": "    if seconds < 60:",
 "177": "        return f\"{seconds} сек\"",
 "178": "    minutes = int(round(seconds / 60))",
 "179": "    if minutes < 60:",
 "180": "        return f\"{minutes} мин\"",
 "181": "    hours, mins = divmod(minutes, 60)",
 "182": "    return f\"{hours} ч {mins} мин\" if mins else f\"{hours} ч\"",
 "183": "",
 "184": "",
 "185": "def _estimate_seconds(total_combinations, symbols_count, timeframes_count=1):",
 "186": "    \"\"\"Оценка длительности прогона (сек).",
 "187": "",
 "188": "    combos × SCAN_SECONDS_PER_COMBINATION / SCAN_WORKERS — параллельные",
 "189": "    бэктесты в ThreadPoolExecutor; fetch — symbols × timeframes ×",
 "190": "    SCAN_FETCH_SECONDS_PER_SYMBOL (данные тянутся по каждому символу",
 "191": "    отдельно на КАЖДЫЙ ТФ, см. scanner.run_scan).",
 "192": "",
 "193": "    combos_per_tf считаем для наглядности: total размазан по ТФ, но",
 "194": "    стоимость бэктестов от разбивки не зависит — важен общий объём.",
 "195": "    \"\"\"",
 "196": "    timeframes = max(1, int(timeframes_count))",
 "197": "    combos_per_tf = total_combinations / timeframes",
 "198": "    workers = max(1, int(config.SCAN_WORKERS))",
 "199": "    backtests = (total_combinations * config.SCAN_SECONDS_PER_COMBINATION",
 "200": "                 / workers)",
 "201": "    fetch = (symbols_count * timeframes",
 "202": "             * config.SCAN_FETCH_SECONDS_PER_SYMBOL)",
 "203": "    return int(round(backtests + fetch))",
 "204": "@bp.route(\"/api/scan\", methods=[\"POST\"])",
 "205": "def api_scan_start():",
 "206": "    \"\"\"Запуск grid-search скана по массиву ТФ. Возвращает {run_id, status: \"started\"}.",
 "207": "",
 "208": "    body.timeframes — список ТФ ([\"15m\", \"1H\"]); body.timeframe (single str)",
 "209": "    принимается для обратной совместимости и нормализуется в [_normalize_timeframes].",
 "210": "    Каждый ТФ валидируется против config.SCAN_TIMEFRAMES.",
 "211": "",
 "212": "    Опционально body.custom_grids — свои вариации параметров:",
 "213": "      {\"sma_cross\": {\"fast\": [5, 10, 15], \"slow\": [20, 30]}, ...}",
 "214": "    Параметры, не указанные в custom grid, берутся из дефолтного грида.",
 "215": "",
 "216": "    Защита от перегрузки: total > SCAN_MAX_COMBINATIONS -> 400 (скан не",
 "217": "    стартует); оценка > SCAN_HARD_LIMIT_SECONDS (4 часа) -> 400; оценка >",
 "218": "    SCAN_WARN_SECONDS (30 минут) -> 200 + warning (UI спрашивает подтверждение).",
 "219": "    В ответе всегда масштаб прогона: estimated_seconds, estimated_human,",
 "220": "    total_combinations, total_symbols, total_timeframes.",
 "221": "    \"\"\"",
 "222": "    body = request.get_json(silent=True) or {}",
 "223": "    symbols = body.get(\"symbols\") or []",
 "224": "    strategies = body.get(\"strategies\") or []",
 "225": "    custom_grids = body.get(\"custom_grids\") or None",
 "226": "",
 "227": "    if not isinstance(symbols, list) or not symbols:",
 "228": "        return jsonify({\"error\": \"symbols must be a non-empty list\"}), 400",
 "229": "    if not isinstance(strategies, list) or not strategies:",
 "230": "        return jsonify({\"error\": \"strategies must be a non-empty list\"}), 400",
 "231": "",
 "232": "    symbols = [str(s).upper() for s in symbols]",
 "233": "    strategies = [str(s) for s in strategies]",
 "234": "    bad_symbols = [s for s in symbols if s not in config.SYMBOLS]",
 "235": "    if bad_symbols:",
 "236": "        return jsonify({\"error\": f\"Invalid symbols: {bad_symbols}\"}), 400",
 "237": "    bad_strategies = [s for s in strategies",
 "238": "                      if s not in config.SCAN_ALLOWED_STRATEGIES]",
 "239": "    if bad_strategies:",
 "240": "        return jsonify({\"error\": f\"Unknown strategies: {bad_strategies}\"}), 400",
 "241": "",
 "242": "    # Таймфреймы: массив или fallback на single timeframe (обратная совместимость).",
 "243": "    timeframes = _normalize_timeframes(",
 "244": "        body.get(\"timeframes\") or body.get(\"timeframe\"))",
 "245": "    if not timeframes:",
 "246": "        return jsonify({\"error\": \"At least one timeframe required\"}), 400",
 "247": "",
 "248": "    # Валидация каждого ТФ против SCAN_TIMEFRAMES.",
 "249": "    bad_tf = [tf for tf in timeframes if tf not in config.SCAN_TIMEFRAMES]",
 "250": "    if bad_tf:",
 "251": "        return jsonify({\"error\": f\"Invalid timeframes: {bad_tf}\"}), 400",
 "252": "",
 "253": "    grids = None",
 "254": "    if custom_grids:",
 "255": "        grids, err = _validate_custom_grids(custom_grids)",
 "256": "        if err:",
 "257": "            return jsonify({",
 "258": "                \"error\": err,",
 "259": "                \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "260": "            }), 400",
 "261": "",
 "262": "    # Объём скана (symbols × timeframes × Σ combos) считаем до старта:",
 "263": "    # UI показывает масштаб — сколько всего комбинаций будет прогнано.",
 "264": "    total_combinations = scanner_mod.plan_totals(",
 "265": "        symbols, strategies, grids=grids, timeframes=timeframes)",
 "266": "    if total_combinations > config.SCAN_MAX_COMBINATIONS:",
 "267": "        return jsonify({",
 "268": "            \"error\": (f\"Too many combinations: {total_combinations} > \"",
 "269": "                      f\"{config.SCAN_MAX_COMBINATIONS}. \"",
 "270": "                      \"Сократите символы, ТФ или стратегии.\"),",
 "271": "            \"total_combinations\": total_combinations,",
 "272": "            \"total_symbols\": len(symbols),",
 "273": "            \"total_timeframes\": len(timeframes),",
 "274": "            \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "275": "        }), 400",
 "276": "",
 "277": "    estimated_seconds = _estimate_seconds(",
 "278": "        total_combinations, len(symbols), len(timeframes))",
 "279": "    if estimated_seconds > config.SCAN_HARD_LIMIT_SECONDS:",
 "280": "        return jsonify({",
 "281": "            \"error\": (f\"Too long: прогон займёт \"",
 "282": "                      f\"{_human_seconds(estimated_seconds)} > 4 часов. \"",
 "283": "                      \"Сократите объём или запустите по частям.\"),",
 "284": "            \"estimated_seconds\": estimated_seconds,",
 "285": "            \"estimated_human\": _human_seconds(estimated_seconds),",
 "286": "            \"total_combinations\": total_combinations,",
 "287": "            \"total_symbols\": len(symbols),",
 "288": "            \"total_timeframes\": len(timeframes),",
 "289": "            \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "290": "            \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "291": "        }), 400",
 "292": "",
 "293": "    warning = None",
 "294": "    if estimated_seconds > config.SCAN_WARN_SECONDS:",
 "295": "        warning = (f\"Прогон займёт {_human_seconds(estimated_seconds)} \"",
 "296": "                   f\"(больше 30 минут). Продолжить?\")",
 "297": "",
 "298": "    run_id = uuid.uuid4().hex",
 "299": "",
 "300": "    def _bg():",
 "301": "        try:",
 "302": "            scanner_mod.run_scan(",
 "303": "                symbols, timeframes, strategies,",
 "304": "                run_id=run_id, grids=grids)",
 "305": "        except Exception:  # noqa: BLE001",
 "306": "            log.exception(\"scan run %s failed\", run_id)",
 "307": "",
 "308": "    threading.Thread(target=_bg, daemon=True,",
 "309": "                     name=f\"scan-{run_id[:8]}\").start()",
 "310": "    payload = {",
 "311": "        \"run_id\": run_id, \"status\": \"started\",",
 "312": "        \"total_combinations\": total_combinations,",
 "313": "        \"estimated_seconds\": estimated_seconds,",
 "314": "        \"estimated_human\": _human_seconds(estimated_seconds),",
 "315": "        \"total_symbols\": len(symbols),",
 "316": "        \"total_timeframes\": len(timeframes),",
 "317": "        \"warn_seconds\": config.SCAN_WARN_SECONDS,",
 "318": "        \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "319": "        \"filtered_count\": scanner_mod.get_run_stats(run_id).get(\"filtered\", 0),",
 "320": "    }",
 "321": "    if warning:",
 "322": "        payload[\"warning\"] = warning",
 "323": "    return jsonify(payload)",
 "324": "",
 "325": "",
 "326": "",
 "327": "",
 "328": "@bp.route(\"/api/scan/<run_id>\")",
 "329": "",
