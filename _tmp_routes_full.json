 "331": "@bp.route(\"/api/scan/<run_id>\")",
 "332": "def api_scan_results(run_id):",
 "333": "    \"\"\"Топ-результаты прогона, отсортированные по combined_sharpe DESC.",
 "334": "",
 "335": "    ?min_sharpe=0 (default) — показывать только прибыльные комбинации;",
 "336": "    ?min_sharpe=-999 — показать всё. Если ни один результат не прошёл",
 "337": "    фильтр — возвращаем warning, а не молчаливый пустой список.",
 "338": "    \"\"\"",
 "339": "    try:",
 "340": "        min_sharpe = float(request.args.get(\"min_sharpe\", 0))",
 "341": "    except (TypeError, ValueError):",
 "342": "        min_sharpe = 0.0",
 "343": "    results = [_annotate(r) for r in db.db_get_scan_results(",
 "344": "        run_id, limit=config.SCAN_TOP_N)",
 "345": "        if (r.get(\"combined_sharpe\") or 0) >= min_sharpe]",
 "346": "    stats = scanner_mod.get_run_stats(run_id)",
 "347": "    if not results:",
 "348": "        return jsonify({",
 "349": "            \"run_id\": run_id, \"results\": [], \"count\": 0,",
 "350": "            \"warning\": \"Все комбинации убыточны. Попробуйте другую \"",
 "351": "                       \"стратегию или timeframe.\",",
 "352": "            \"stats\": stats,",
 "353": "        })",
 "354": "    return jsonify({\"run_id\": run_id, \"results\": results,",
 "355": "                    \"count\": len(results), \"stats\": stats})",
 "356": "",
 "357": "",
 "358": "@bp.route(\"/api/scan/grids\")",
 "359": "def api_scan_grids():",
 "360": "    \"\"\"Доступные стратегии (параметры + дефолтные гриды) и ТФ — для UI.",
 "361": "",
 "362": "    param_limits и константы оценки нужны фронту, чтобы считать число",
 "363": "    комбинаций (и время прогона) теми же цифрами, что и POST /api/scan.",
 "364": "    default_timeframes — ТФ, отмеченные в UI по умолчанию (чекбоксы",
 "365": "    #scan-timeframes): берутся из config.SCAN_DEFAULT_TIMEFRAMES.",
 "366": "    \"\"\"",
 "367": "    return jsonify({",
 "368": "        \"strategies\": config.SCAN_ALLOWED_STRATEGIES,",
 "369": "        \"timeframes\": config.SCAN_TIMEFRAMES,",
 "370": "        \"default_timeframes\": list(config.SCAN_DEFAULT_TIMEFRAMES),",
 "371": "        \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "372": "        \"max_custom_values\": config.SCAN_MAX_CUSTOM_VALUES,",
 "373": "        \"param_limits\": config.SCAN_PARAM_LIMITS,",
 "374": "        \"workers\": config.SCAN_WORKERS,",
 "375": "        \"seconds_per_combination\": config.SCAN_SECONDS_PER_COMBINATION,",
 "376": "        \"fetch_seconds_per_symbol\": config.SCAN_FETCH_SECONDS_PER_SYMBOL,",
 "377": "        \"warn_seconds\": config.SCAN_WARN_SECONDS,",
 "378": "        \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "379": "    })",
 "380": "",
 "381": "",
 "382": "@bp.route(\"/api/scan/<run_id>/summary\")",
 "383": "def api_scan_summary(run_id):",
 "384": "    \"\"\"Человекочитаемая сводка прогона: вердикты, лучшие по символам,",
 "385": "    рекомендации (для UI-блока сверху и копирования отчёта).\"\"\"",
 "386": "    annotated = [_annotate(r) for r in",
 "387": "                 db.db_get_scan_results(run_id, limit=10 ** 9)]",
 "388": "    kept = len(annotated)",
 "389": "    stats = scanner_mod.get_run_stats(run_id)",
 "390": "    total = int(stats.get(\"total\") or 0) or kept",
 "391": "",
 "392": "    by_verdict = {}",
 "393": "    best_by_symbol = {}",
 "394": "    verdicts_by_symbol = {}",
 "395": "    for r in annotated:",
 "396": "        by_verdict[r[\"verdict\"]] = by_verdict.get(r[\"verdict\"], 0) + 1",
 "397": "        sym = r.get(\"symbol\") or \"?\"",
 "398": "        verdicts_by_symbol.setdefault(sym, []).append(r[\"verdict\"])",
 "399": "        cur = best_by_symbol.get(sym)",
 "400": "        if cur is None or (r.get(\"combined_sharpe\") or 0) \\",
 "401": "                > (cur.get(\"combined_sharpe\") or 0):",
 "402": "            best_by_symbol[sym] = {",
 "403": "                \"symbol\": sym,",
 "404": "                \"strategy\": r.get(\"strategy\"),",
 "405": "                \"strategy_label\": r[\"strategy_label\"],",
 "406": "                \"params\": r.get(\"params\") or {},",
 "407": "                \"combined_sharpe\": r.get(\"combined_sharpe\"),",
 "408": "                \"verdict\": r[\"verdict\"],",
 "409": "            }",
 "410": "",
 "411": "    stable = [r for r in annotated if r[\"verdict\"] == \"stable\"]",
 "412": "    stable.sort(key=lambda r: r.get(\"combined_sharpe\") or 0, reverse=True)",
 "413": "    recommendations = []",
 "414": "    for r in stable[:3]:",
 "415": "        recommendations.append(",
 "416": "            f\"✅ {r.get('symbol')} + {r['strategy_label']} — стабильный edge,\"",
 "417": "            f\" sharpe {round(r.get('combined_sharpe') or 0, 2)}\")",
 "418": "    if not stable:",
 "419": "        recommendations.append(\"Ни одна стратегия не показала стабильный edge\")",
 "420": "    for sym, vs in verdicts_by_symbol.items():",
 "421": "        # Символ, где ВСЕ комбинации убыточны — «проблемный».",
 "422": "        if vs and all(v == \"losing\" for v in vs):",
 "423": "            recommendations.append(",
 "424": "                f\"⚠️ {sym} — ни одна комбинация не работает стабильно\")",
 "425": "    if stable:",
 "426": "        best = stable[0]",
 "427": "        recommendations.append(",
 "428": "            f\"🎯 Лучший вариант: {best.get('symbol')}, \"",
 "429": "            f\"{best['strategy_label']}\")",
 "430": "",
 "431": "    return jsonify({",
 "432": "        \"run_id\": run_id,",
 "433": "        \"total_combinations\": total,",
 "434": "        \"kept\": kept,",
 "435": "        \"by_verdict\": by_verdict,",
 "436": "        \"best_by_symbol\": best_by_symbol,",
 "437": "        \"recommendations\": recommendations,",
 "438": "    })",
 "439": "",
 "440": "",
 "441": "@bp.route(\"/api/scan/<run_id>/export.csv\")",
 "442": "def api_scan_export_csv(run_id):",
 "443": "    \"\"\"CSV со ВСЕМИ результатами прогона (не только топ-N).",
 "444": "",
 "445": "    winrate/max_dd/profit_factor/trades — out-of-sample (test) значения.",
 "446": "    \"\"\"",
 "447": "    results = db.db_get_scan_results(run_id, limit=10 ** 9)",
 "448": "    buf = io.StringIO()",
 "449": "    writer = csv.writer(buf)",
 "450": "    writer.writerow([\"symbol\", \"timeframe\", \"strategy\", \"params\", \"train_sharpe\",",
 "451": "                     \"test_sharpe\", \"combined_sharpe\", \"winrate\", \"max_dd\",",
 "452": "                     \"profit_factor\", \"trades\"])",
 "453": "    for r in results:",
 "454": "        train = r.get(\"train\") or {}",
 "455": "        test = r.get(\"test\") or {}",
 "456": "        writer.writerow([",
 "457": "            r.get(\"symbol\", \"\"),",
 "458": "            r.get(\"timeframe\", \"\"),",
 "459": "            r.get(\"strategy\", \"\"),",
 "460": "            json.dumps(r.get(\"params\") or {}, ensure_ascii=False),",
 "461": "            train.get(\"sharpe\", \"\"),",
 "462": "            test.get(\"sharpe\", \"\"),",
 "463": "            r.get(\"combined_sharpe\", \"\"),",
 "464": "            test.get(\"winrate\", \"\"),",
 "465": "            test.get(\"max_dd\", \"\"),",
 "466": "            test.get(\"profit_factor\", \"\"),",
 "467": "            test.get(\"trades\", \"\"),",
 "468": "        ])",
 "469": "    return Response(",
 "470": "        buf.getvalue(), mimetype=\"text/csv\",",
 "471": "        headers={\"Content-Disposition\":",
 "472": "                 f\"attachment; filename=scan_{run_id}.csv\"})"
}