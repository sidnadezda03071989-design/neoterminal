{
 "1": "# -*- coding: utf-8 -*-",
 "2": "\"\"\"Blueprint: /api/scan (grid-search сканер стратегий).",
 "3": "",
 "4": "POST /api/scan                   — запуск скана (опц. body.custom_grids)",
 "5": "GET  /api/scan/grids             — доступные стратегии/гриды/ТФ для UI",
 "6": "GET  /api/scan/<run_id>          — топ SCAN_TOP_N + verdict по каждой",
 "7": "GET  /api/scan/<run_id>/summary  — человекочитаемая сводка + рекомендации",
 "8": "GET  /api/scan/<run_id>/export.csv — CSV со всеми результатами прогона",
 "9": "\"\"\"",
 "10": "",
