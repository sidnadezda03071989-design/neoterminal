 "235": "# ------------------------------------------------------ POST /api/scan: лимиты",
 "236": "def test_api_scan_all_12_strategies_default_grid(client, monkeypatch):",
 "237": "    \"\"\"12 стратегий с дефолтными гридами: 402 комбинации, без warning.\"\"\"",
 "238": "    done_ev = _patch_run_scan(monkeypatch)",
