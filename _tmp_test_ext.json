 "94": "def _patch_run_scan(monkeypatch, called=None):",
 "95": "    \"\"\"Подмена скана в фоне: POST /api/scan не должен реально считать.\"\"\"",
 "96": "    done_ev = threading.Event()",
 "97": "",
 "98": "    def fake_run_scan(symbols, timeframe, strategies, run_id=None, grids=None):",
 "99": "        if called is not None:",
 "100": "            called.update(symbols=symbols, timeframe=timeframe,",
 "101": "                          strategies=strategies, run_id=run_id, grids=grids)",
 "102": "        done_ev.set()",
 "103": "",
 "104": "    monkeypatch.setattr(scanner_mod, \"run_scan\", fake_run_scan)",
 "105": "    return done_ev",
