 "460": "# --------------------------------------------------------- ETA в прогрессе",
 "461": "def test_eta_seconds_math():",
 "462": "    \"\"\"rate = done/elapsed, eta = (total - done) / rate.\"\"\"",
 "463": "    start = time.time() - 10",
 "464": "    assert scanner_mod._eta_seconds(start, 0, 100) is None   # не начали",
 "465": "    assert scanner_mod._eta_seconds(start, 100, 100) is None  # закончили",
 "466": "    eta = scanner_mod._eta_seconds(start, 20, 100)            # 20 за 10 сек",
 "467": "    assert eta is not None and 35 <= eta <= 45",
 "468": "",
 "469": "",
 "470": "def test_run_scan_pushes_eta_every_n_combinations(monkeypatch):",
 "471": "    \"\"\"scan_progress: eta_seconds раз в SCAN_ETA_PUSH_EVERY комбинаций.\"\"\"",
 "472": "    monkeypatch.setattr(scanner_mod, \"get_replay_df\",",
 "473": "                        lambda *a, **k: _mk_df(1000))",
 "474": "    monkeypatch.setattr(scanner_mod, \"run_backtest\", _fake_run_backtest())",
 "475": "    monkeypatch.setitem(config.SCAN_GRIDS, \"sma_cross\",",
 "476": "                        {\"fast\": [5, 10, 15, 20, 25]})",
 "477": "    monkeypatch.setattr(config, \"SCAN_MIN_TRADES\", 0)",
 "478": "    events = []",
 "479": "    monkeypatch.setattr(scanner_mod, \"_ws_push\",",
 "480": "                        lambda event, data: events.append((event, data)))",
 "481": "",
 "482": "    # 3 символа × 5 комбинаций = 15: ETA приходит на done=10, не на финале",
 "483": "    run_id = scanner_mod.run_scan([\"BTCUSDT\", \"ETHUSDT\", \"USDCHF\"], \"15m\",",
 "484": "                                  [\"sma_cross\"])",
 "485": "    _RUN_IDS.append(run_id)",
 "486": "",
 "487": "    assert all(ev == \"scan_progress\" for ev, _ in events)",
 "488": "    eta_events = [d for _, d in events if \"eta_seconds\" in d]",
 "489": "    assert eta_events, \"ни одного события с eta_seconds\"",
 "490": "    assert all(d[\"done\"] % config.SCAN_ETA_PUSH_EVERY == 0 for d in eta_events)",
 "491": "    # На быстром моке ETA может округлиться до 0 — важно, что это int >= 0.",
 "492": "    assert all(isinstance(d[\"eta_seconds\"], int) and d[\"eta_seconds\"] >= 0",
 "493": "               for d in eta_events)",
 "494": "    # финальное событие (done == total) — без ETA",
 "495": "    assert events[-1][1][\"done\"] == 15",
 "496": "    assert \"eta_seconds\" not in events[-1][1]",
 "497": "    # ETA дублируется в RUN_STATS (фолбэк поллинга UI)",
 "498": "    stats = scanner_mod.get_run_stats(run_id)",
 "499": "    assert stats[\"finished\"] is True",
 "500": "    assert isinstance(stats[\"eta_seconds\"], int)"
