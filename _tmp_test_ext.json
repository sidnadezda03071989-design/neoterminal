 "124": "# ------------------------------------------------------------ /api/scan/grids",
 "125": "def test_api_scan_grids_returns_12_strategies(client):",
 "126": "    \"\"\"/api/scan/grids: 12 стратегий, у каждой label/params/default_grid.\"\"\"",
 "127": "    resp = client.get(\"/api/scan/grids\")",
 "128": "    assert resp.status_code == 200",
 "129": "    data = resp.get_json()",
 "130": "    assert len(data[\"strategies\"]) == 12",
 "131": "    assert set(data[\"strategies\"]) == set(config.SCAN_GRIDS)",
 "132": "    for sid in NEW_STRATEGIES:",
 "133": "        meta = data[\"strategies\"][sid]",
 "134": "        assert meta[\"label\"] and meta[\"params\"] and meta[\"default_grid\"]",
 "135": "    # Константы для UI: лимиты и оценка времени (scanner.js считает так же)",
 "136": "    assert data[\"max_combinations\"] == 50000",
 "137": "    assert data[\"max_custom_values\"] == 30",
 "138": "    assert data[\"param_limits\"][\"vwap_threshold\"] == [0.001, 0.05]",
 "139": "    assert data[\"param_limits\"][\"adx_threshold\"] == [10, 50]",
 "140": "    assert data[\"workers\"] == config.SCAN_WORKERS",
 "141": "    assert (data[\"seconds_per_combination\"]",
 "142": "            == config.SCAN_SECONDS_PER_COMBINATION)",
 "143": "    assert data[\"warn_seconds\"] == 1800",
 "144": "    assert data[\"hard_limit_seconds\"] == config.SCAN_HARD_LIMIT_SECONDS == 14400",
