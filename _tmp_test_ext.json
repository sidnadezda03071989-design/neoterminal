 "208": "# --------------------------------------------------------- оценка длительности",
 "209": "def test_estimate_seconds_formula():",
 "210": "    \"\"\"combos × 0.3 / workers(8) + symbols × TF × 15 сек (см. config).\"\"\"",
 "211": "    assert _estimate_seconds(0, 1) == 15          # symbols × 1 ТФ × 15",
 "212": "    assert _estimate_seconds(5000, 10) == round(5000 * 0.3 / 8 + 10 * 15)",
 "213": "    assert _human_seconds(45) == \"45 сек\"",
 "214": "    assert _human_seconds(12 * 60) == \"12 мин\"",
 "215": "    assert _human_seconds(2 * 3600 + 15 * 60) == \"2 ч 15 мин\"",
 "216": "    assert _human_seconds(4 * 3600 + 15 * 60) == \"4 ч 15 мин\"",
 "217": "    assert _human_seconds(3600) == \"1 ч\"",
 "218": "",
 "219": "",
 "220": "def test_estimate_seconds_scales_fetch_by_timeframes():",
 "221": "    \"\"\"6 ТФ -> fetch-компонент symbols × 6 × 15 (данные тянутся на каждый ТФ).\"\"\"",
 "222": "    assert _estimate_seconds(0, 10, 6) == 10 * 6 * 15 == 900",
 "223": "    assert _estimate_seconds(5000, 10, 6) == round(",
 "224": "        5000 * config.SCAN_SECONDS_PER_COMBINATION / config.SCAN_WORKERS",
 "225": "        + 10 * 6 * config.SCAN_FETCH_SECONDS_PER_SYMBOL)",
 "226": "    # Масштабный прогон 10 символов × 6 ТФ × 402 комб. = 24120: разница с",
 "227": "    # одним ТФ — ровно фетч за 5 дополнительных ТФ.",
 "228": "    one_tf = _estimate_seconds(24120, 10, 1)",
 "229": "    six_tf = _estimate_seconds(24120, 10, 6)",
 "230": "    assert six_tf - one_tf == 10 * 5 * 15",
 "231": "    # timeframes_count защищён от нуля/мусора: 0 -> 1 ТФ.",
 "232": "    assert _estimate_seconds(0, 3, 0) == _estimate_seconds(0, 3)",
