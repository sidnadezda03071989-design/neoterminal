 "147": "@pytest.mark.parametrize(\"sid\", NEW_STRATEGIES)",
 "148": "def test_scan_grid_sizes_for_new_strategies(sid):",
 "149": "    \"\"\"Гриды 9 новых стратегий = ожидаемые размеры (25/12/16/54/6/27/4/12).\"\"\"",
 "150": "    grid = config.SCAN_GRIDS[sid]",
 "151": "    assert grid, f\"{sid}: пустой грид\"",
 "152": "    size = 1",
 "153": "    for values in grid.values():",
 "154": "        size *= len(values)",
 "155": "    assert size == EXPECTED_GRID_SIZES[sid]",
 "156": "    # Каждый параметр грида разрешён в SCAN_ALLOWED_STRATEGIES",
 "157": "    assert set(grid) == set(config.SCAN_ALLOWED_STRATEGIES[sid][\"params\"])",
 "158": "",
