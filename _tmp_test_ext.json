 "252": "def test_api_scan_accepts_max_combinations_50000(client, monkeypatch):",
 "253": "    \"\"\"50000 комбинаций (10 символов × GRID_5000) — ровно лимит: 200 OK.",
 "254": "",
 "255": "    Оценка такого прогона (~34 мин) уже больше SCAN_WARN_SECONDS, поэтому",
 "256": "    ответ приходит с warning, но скан стартует (hard-limit 4ч не превышен).",
 "257": "    \"\"\"",
 "258": "    done_ev = _patch_run_scan(monkeypatch)",
 "259": "    resp = client.post(\"/api/scan\", json={",
 "260": "        \"symbols\": ALL_SYMBOLS, \"timeframe\": \"15m\",",
 "261": "        \"strategies\": [\"stoch_reversal\"], \"custom_grids\": GRID_5000,",
 "262": "    })",
 "263": "    assert resp.status_code == 200",
 "264": "    data = resp.get_json()",
 "265": "    assert config.SCAN_MAX_COMBINATIONS == 50000",
 "266": "    assert data[\"total_combinations\"] == 50000",
 "267": "    assert data[\"estimated_seconds\"] == _estimate_seconds(50000, 10) == 2025",
 "268": "    # Масштаб прогона в ответе — всегда (UI показывает его до старта).",
 "269": "    assert data[\"estimated_human\"] == \"34 мин\"",
 "270": "    assert data[\"total_symbols\"] == 10 and data[\"total_timeframes\"] == 1",
 "271": "    assert data[\"hard_limit_seconds\"] == config.SCAN_HARD_LIMIT_SECONDS",
 "272": "    assert \"больше 30 минут\" in data[\"warning\"]",
 "273": "    assert done_ev.wait(timeout=5)",
