 "160": "def test_all_strategies_have_grid_and_total_is_402():",
 "161": "    \"\"\"12 стратегий в гридах = 12 в allowed, сумма гридов = 402 комбинации.\"\"\"",
 "162": "    assert set(config.SCAN_GRIDS) == set(config.SCAN_ALLOWED_STRATEGIES)",
 "163": "    assert len(config.SCAN_ALLOWED_STRATEGIES) == 12",
 "164": "    total = 0",
 "165": "    for grid in config.SCAN_GRIDS.values():",
 "166": "        size = 1",
 "167": "        for values in grid.values():",
 "168": "            size *= len(values)",
 "169": "        total += size",
 "170": "    assert total == EXPECTED_TOTAL_COMBOS",
