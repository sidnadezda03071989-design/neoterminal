 "276": "def test_api_scan_rejects_over_max_combinations(client):",
 "277": "    \"\"\"50090 > 50000 -> 400 'Too many combinations' и скан не стартует.",
 "278": "",
 "279": "    10 символов × (5000 stoch + 9 sma_cross) = 50090. Больше лимита не",
 "280": "    конструируется точно на 50001: на параметр не больше",
 "281": "    SCAN_MAX_CUSTOM_VALUES=30 значений, а 50001 = 3 × 7 × 2381 (простое).",
 "282": "    \"\"\"",
 "283": "    grids = dict(GRID_5000)",
 "284": "    grids[\"sma_cross\"] = {\"fast\": [5]}   # 1 × 9 (slow из дефолта) = +9",
 "285": "    resp = client.post(\"/api/scan\", json={",
 "286": "        \"symbols\": ALL_SYMBOLS, \"timeframe\": \"15m\",",
 "287": "        \"strategies\": [\"stoch_reversal\", \"sma_cross\"], \"custom_grids\": grids,",
 "288": "    })",
 "289": "    assert resp.status_code == 400",
 "290": "    data = resp.get_json()",
 "291": "    assert data[\"total_combinations\"] == 50090",
 "292": "    assert \"Too many combinations\" in data[\"error\"]",
 "293": "    assert \"50090 > 50000\" in data[\"error\"]",
 "294": "    assert data[\"max_combinations\"] == 50000",
