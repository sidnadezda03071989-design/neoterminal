 "67": "def _mk_df(n=1000, end_ts=1_700_000_000, step=900):",
 "68": "    \"\"\"Свечи шагом step, возрастающие по времени (как в get_replay_df).\"\"\"",
 "69": "    ts = [end_ts - i * step for i in range(n)][::-1]",
 "70": "    return pd.DataFrame({",
 "71": "        \"timestamp\": pd.to_datetime(ts, unit=\"s\", utc=True),",
 "72": "        \"open\": [1.0] * n,",
 "73": "        \"high\": [2.0] * n,",
 "74": "        \"low\": [0.5] * n,",
 "75": "        \"close\": [1.5 + i for i in range(n)],",
 "76": "        \"volume\": [10.0] * n,",
 "77": "    })",
 "78": "",
 "79": "",
 "80": "def _fake_run_backtest(train_sharpe=1.5, test_sharpe=0.8, trades=50):",
 "81": "    \"\"\"Мок run_backtest: train-окно (len(df) > 500 из 1000) -> train_sharpe.\"\"\"",
 "82": "    def fake(symbol, tf, from_sec, to_sec, strategy_name, params,",
 "83": "             initial_cash=10000, replay_limit=None, df=None):",
 "84": "        sharpe = train_sharpe if (df is not None and len(df) > 500) \\",
 "85": "            else test_sharpe",
 "86": "        return {",
 "87": "            \"total_return\": 0.1, \"sharpe_ratio\": sharpe, \"max_drawdown\": 0.05,",
 "88": "            \"total_trades\": trades, \"win_rate\": 0.6,",
 "89": "            \"trades\": [{\"pnl\": 10.0}] * 5, \"equity_curve\": [],",
 "90": "        }",
 "91": "    return fake",
 "92": "",
