 "356": "def test_api_scan_rejects_run_longer_than_4hours(client, monkeypatch):",
 "357": "    \"\"\"Оценка 15000 сек (> SCAN_HARD_LIMIT_SECONDS) -> 400 'Too long'.\"\"\"",
 "358": "    _patch_run_scan(monkeypatch)",
 "359": "    # 50000 × 2.376 / 8 = 14850 + 150 = 15000 сек (4 ч 10 мин).",
 "360": "    monkeypatch.setattr(config, \"SCAN_SECONDS_PER_COMBINATION\", 2.376)",
 "361": "    resp = client.post(\"/api/scan\", json={",
 "362": "        \"symbols\": ALL_SYMBOLS, \"timeframe\": \"15m\",",
 "363": "        \"strategies\": [\"stoch_reversal\"], \"custom_grids\": GRID_5000,",
 "364": "    })",
 "365": "    assert resp.status_code == 400",
 "366": "    data = resp.get_json()",
 "367": "    assert data[\"estimated_seconds\"] == 15000",
 "368": "    assert data[\"estimated_human\"] == \"4 ч 10 мин\"",
 "369": "    assert data[\"estimated_seconds\"] > config.SCAN_HARD_LIMIT_SECONDS == 14400",
