 "242": "@bp.route(\"/api/scan/<run_id>\")",
 "243": "def api_scan_results(run_id):",
 "244": "    \"\"\"Топ-результаты прогона, отсортированные по combined_sharpe DESC.",
 "245": "",
 "246": "    ?min_sharpe=0 (default) — показывать только прибыльные комбинации;",
 "247": "    ?min_sharpe=-999 — показать всё. Если ни один результат не прошёл",
 "248": "    фильтр — возвращаем warning, а не молчаливый пустой список.",
 "249": "    \"\"\"",
 "250": "    try:",
 "251": "        min_sharpe = float(request.args.get(\"min_sharpe\", 0))",
 "252": "    except (TypeError, ValueError):",
 "253": "        min_sharpe = 0.0",
 "254": "    results = [_annotate(r) for r in db.db_get_scan_results(",
 "255": "        run_id, limit=config.SCAN_TOP_N)",
 "256": "        if (r.get(\"combined_sharpe\") or 0) >= min_sharpe]",
 "257": "    stats = scanner_mod.get_run_stats(run_id)",
 "258": "    if not results:",
 "259": "        return jsonify({",
 "260": "            \"run_id\": run_id, \"results\": [], \"count\": 0,",
 "261": "            \"warning\": \"Все комбинации убыточны. Попробуйте другую \"",
 "262": "                       \"стратегию или timeframe.\",",
 "263": "            \"stats\": stats,",
 "264": "        })",
 "265": "    return jsonify({\"run_id\": run_id, \"results\": results,",
 "266": "                    \"count\": len(results), \"stats\": stats})",
 "267": "",
 "268": "",
 "269": "@bp.route(\"/api/scan/grids\")",
 "270": "def api_scan_grids():",
 "271": "    \"\"\"Доступные стратегии (параметры + дефолтные гриды) и ТФ — для UI.",
 "272": "",
 "273": "    param_limits и константы оценки нужны фронту, чтобы считать число",
 "274": "    комбинаций (и время прогона) теми же цифрами, что и POST /api/scan.",
 "275": "    default_timeframes — ТФ, отмеченные в UI по умолчанию (чекбоксы",
 "276": "    #scan-timeframes): берутся из config.SCAN_DEFAULT_TIMEFRAMES.",
 "277": "    \"\"\"",
 "278": "    return jsonify({",
 "279": "        \"strategies\": config.SCAN_ALLOWED_STRATEGIES,",
 "280": "        \"timeframes\": config.SCAN_TIMEFRAMES,",
 "281": "        \"default_timeframes\": list(config.SCAN_DEFAULT_TIMEFRAMES),",
 "282": "        \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "283": "        \"max_custom_values\": config.SCAN_MAX_CUSTOM_VALUES,",
 "284": "        \"param_limits\": config.SCAN_PARAM_LIMITS,",
 "285": "        \"workers\": config.SCAN_WORKERS,",
 "286": "        \"seconds_per_combination\": config.SCAN_SECONDS_PER_COMBINATION,",
 "287": "        \"fetch_seconds_per_symbol\": config.SCAN_FETCH_SECONDS_PER_SYMBOL,",
 "288": "        \"warn_seconds\": config.SCAN_WARN_SECONDS,",
 "289": "        \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "290": "    })",
 "291": "",
 "292": "",
 "293": "@bp.route(\"/api/scan/<run_id>/summary\")",
 "294": "def api_scan_summary(run_id):",
 "295": "    \"\"\"Человекочитаемая сводка прогона: вердикты, лучшие по символам,",
 "296": "    рекомендации (для UI-блока сверху и копирования отчёта).\"\"\""
}