{
 "1": "        return \"losing\", \"Убыточна на новых данных\", \"poor\"",
 "2": "    if train_sharpe - test_sharpe > 0.4:",
 "3": "        return \"overfit\", \"Переоптимизация (train >> test)\", \"poor\"",
 "4": "    if trades < 50:",
 "5": "        return \"noise\", \"Мало сделок (< 50) — недостаточно данных\", \"fair\"",
 "6": "    if combined >= 0.5:",
 "7": "        quality = \"excellent\" if combined >= 1.0 else \"good\"",
 "8": "        return \"stable\", \"Стабильна и на train, и на test\", quality",
 "9": "    if combined >= 0.2:",
 "10": "        return \"stable\", \"Работает умеренно\", \"fair\"",
 "11": "    return \"weak\", \"Слабый edge\", \"poor\"",
 "12": "",
 "13": "",
 "14": "def _annotate(result):",
 "15": "    \"\"\"Копия результата + verdict/verdict_text/quality/strategy_label.\"\"\"",
 "16": "    r = dict(result)",
 "17": "    r[\"verdict\"], r[\"verdict_text\"], r[\"quality\"] = _verdict(r)",
 "18": "    r[\"strategy_label\"] = _strategy_label(r)",
 "19": "    return r",
 "20": "",
 "21": "",
 "22": "# --------------------------------------------------------------- custom grids",
 "23": "def _validate_custom_grids(custom_grids):",
 "24": "    \"\"\"Валидация custom_grids -> (merged_grids, None) | (None, error_text).",
 "25": "",
 "26": "    Каждый указанный параметр мержится ПОВЕРХ дефолтного грида: параметры,",
 "27": "    которых нет в custom grid, берутся из SCAN_GRIDS. Проверяем: стратегия",
 "28": "    в SCAN_ALLOWED_STRATEGIES, параметр в allowed list, значения — int в",
 "29": "    разумных пределах, 1..SCAN_MAX_CUSTOM_VALUES значений на параметр,",
 "30": "    общее число комбинаций ≤ SCAN_MAX_COMBINATIONS (та же формулировка",
 "31": "    ошибки, что и в api_scan_start — см. «Too many combinations»).",
 "32": "    \"\"\"",
 "33": "    if not isinstance(custom_grids, dict) or not custom_grids:",
 "34": "        return None, (\"custom_grids должен быть непустым объектом \"",
 "35": "                      \"{стратегия: {param: [значения]}}\")",
 "36": "    grids = {}",
 "37": "    total = 0",
 "38": "    for sid, grid in custom_grids.items():",
 "39": "        meta = config.SCAN_ALLOWED_STRATEGIES.get(sid)",
 "40": "        if not meta:",
 "41": "            return None, f\"Неизвестная стратегия: {sid}\"",
 "42": "        if not isinstance(grid, dict) or not grid:",
 "43": "            return None, f\"{sid}: грид должен быть непустым объектом\"",
 "44": "        clean = {}",
 "45": "        for pname, values in grid.items():",
 "46": "            if pname not in meta[\"params\"]:",
 "47": "                return None, (f\"{sid}: параметр '{pname}' не разрешён \"",
 "48": "                              f\"(разрешены: {', '.join(meta['params'])})\")",
 "49": "            if not isinstance(values, list):",
 "50": "                return None, f\"{sid}.{pname}: нужен список значений\"",
 "51": "            if not 1 <= len(values) <= config.SCAN_MAX_CUSTOM_VALUES:",
 "52": "                return None, (f\"{sid}.{pname}: от 1 до \"",
 "53": "                              f\"{config.SCAN_MAX_CUSTOM_VALUES} значений, \"",
 "54": "                              f\"получено {len(values)}\")",
 "55": "            lo, hi = config.SCAN_PARAM_LIMITS.get(pname, (2, 300))",
 "56": "            # Границы с плавающей точкой (std / multiplier / vwap_threshold)",
 "57": "            # разрешают дробные значения, остальные параметры — только int.",
 "58": "            float_ok = any(isinstance(b, float) for b in (lo, hi))",
 "59": "            clean_values = []",
 "60": "            for v in values:",
 "61": "                if isinstance(v, bool) or not isinstance(v, (int, float)) \\",
 "62": "                        or (not float_ok and not isinstance(v, int)) \\",
 "63": "                        or not lo <= v <= hi:",
 "64": "                    kind = \"число\" if float_ok else \"целое\"",
 "65": "                    return None, (f\"{sid}.{pname}: значение {v!r} — \"",
 "66": "                                  f\"нужно {kind} в диапазоне {lo}–{hi}\")",
 "67": "                clean_values.append(v)",
 "68": "            clean[pname] = clean_values",
 "69": "        merged = {**(config.SCAN_GRIDS.get(sid) or {}), **clean}",
 "70": "        combos = 1",
 "71": "        for vals in merged.values():",
 "72": "            combos *= len(vals)",
 "73": "        total += combos",
 "74": "        grids[sid] = merged",
 "75": "    if total > config.SCAN_MAX_COMBINATIONS:",
 "76": "        # Тот же текст, что и в api_scan_start (проверка по символам):",
 "77": "        # дешёвая проверка произведения длин ДО материализации комбинаций.",
 "78": "        return None, (f\"Too many combinations: {total} > \"",
 "79": "                      f\"{config.SCAN_MAX_COMBINATIONS}. Сократите \"",
 "80": "                      f\"символы, ТФ или стратегии.\")",
 "81": "    return grids, None",
 "82": "",
 "83": "",
 "84": "def _human_seconds(seconds):",
 "85": "    \"\"\"Секунды -> '45 сек' / '12 мин' / '2 ч 15 мин' (для warning и UI).\"\"\"",
 "86": "    seconds = int(seconds)",
 "87": "    if seconds < 60:",
 "88": "        return f\"{seconds} сек\"",
 "89": "    minutes = int(round(seconds / 60))",
 "90": "    if minutes < 60:",
 "91": "        return f\"{minutes} мин\"",
 "92": "    hours, mins = divmod(minutes, 60)",
 "93": "    return f\"{hours} ч {mins} мин\" if mins else f\"{hours} ч\"",
 "94": "",
 "95": "",
 "96": "def _estimate_seconds(total_combinations, symbols_count, timeframes_count=1):",
 "97": "    \"\"\"Оценка длительности прогона (сек).",
 "98": "",
 "99": "    combos × SCAN_SECONDS_PER_COMBINATION / SCAN_WORKERS — параллельные",
 "100": "    бэктесты в ThreadPoolExecutor; fetch — symbols × timeframes ×",
 "101": "    SCAN_FETCH_SECONDS_PER_SYMBOL (данные тянутся по каждому символу",
 "102": "    отдельно на КАЖДЫЙ ТФ, см. scanner.run_scan).",
 "103": "",
 "104": "    combos_per_tf считаем для наглядности: total размазан по ТФ, но",
 "105": "    стоимость бэктестов от разбивки не зависит — важен общий объём.",
 "106": "    \"\"\"",
 "107": "    timeframes = max(1, int(timeframes_count))",
 "108": "    combos_per_tf = total_combinations / timeframes",
 "109": "    workers = max(1, int(config.SCAN_WORKERS))",
 "110": "    backtests = (total_combinations * config.SCAN_SECONDS_PER_COMBINATION",
 "111": "                 / workers)",
 "112": "    fetch = (symbols_count * timeframes",
 "113": "             * config.SCAN_FETCH_SECONDS_PER_SYMBOL)",
 "114": "    return int(round(backtests + fetch))",
 "115": "@bp.route(\"/api/scan\", methods=[\"POST\"])",
 "116": "def api_scan_start():",
 "117": "    \"\"\"Запуск grid-search скана по массиву ТФ. Возвращает {run_id, status: \"started\"}.",
 "118": "",
 "119": "    body.timeframes — список ТФ ([\"15m\", \"1H\"]); body.timeframe (single str)",
 "120": "    принимается для обратной совместимости и нормализуется в [_normalize_timeframes].",
 "121": "    Каждый ТФ валидируется против config.SCAN_TIMEFRAMES.",
 "122": "",
 "123": "    Опционально body.custom_grids — свои вариации параметров:",
 "124": "      {\"sma_cross\": {\"fast\": [5, 10, 15], \"slow\": [20, 30]}, ...}",
 "125": "    Параметры, не указанные в custom grid, берутся из дефолтного грида.",
 "126": "",
 "127": "    Защита от перегрузки: total > SCAN_MAX_COMBINATIONS -> 400 (скан не",
 "128": "    стартует); оценка > SCAN_HARD_LIMIT_SECONDS (4 часа) -> 400; оценка >",
 "129": "    SCAN_WARN_SECONDS (30 минут) -> 200 + warning (UI спрашивает подтверждение).",
 "130": "    В ответе всегда масштаб прогона: estimated_seconds, estimated_human,",
 "131": "    total_combinations, total_symbols, total_timeframes.",
 "132": "    \"\"\"",
 "133": "    body = request.get_json(silent=True) or {}",
 "134": "    symbols = body.get(\"symbols\") or []",
 "135": "    strategies = body.get(\"strategies\") or []",
 "136": "    custom_grids = body.get(\"custom_grids\") or None",
 "137": "",
 "138": "    if not isinstance(symbols, list) or not symbols:",
 "139": "        return jsonify({\"error\": \"symbols must be a non-empty list\"}), 400",
 "140": "    if not isinstance(strategies, list) or not strategies:",
 "141": "        return jsonify({\"error\": \"strategies must be a non-empty list\"}), 400",
 "142": "",
 "143": "    symbols = [str(s).upper() for s in symbols]",
 "144": "    strategies = [str(s) for s in strategies]",
 "145": "    bad_symbols = [s for s in symbols if s not in config.SYMBOLS]",
 "146": "    if bad_symbols:",
 "147": "        return jsonify({\"error\": f\"Invalid symbols: {bad_symbols}\"}), 400",
 "148": "    bad_strategies = [s for s in strategies",
 "149": "                      if s not in config.SCAN_ALLOWED_STRATEGIES]",
 "150": "    if bad_strategies:",
 "151": "        return jsonify({\"error\": f\"Unknown strategies: {bad_strategies}\"}), 400",
 "152": "",
 "153": "    # Таймфреймы: массив или fallback на single timeframe (обратная совместимость).",
 "154": "    timeframes = _normalize_timeframes(",
 "155": "        body.get(\"timeframes\") or body.get(\"timeframe\"))",
 "156": "    if not timeframes:",
 "157": "        return jsonify({\"error\": \"At least one timeframe required\"}), 400",
 "158": "",
 "159": "    # Валидация каждого ТФ против SCAN_TIMEFRAMES.",
 "160": "    bad_tf = [tf for tf in timeframes if tf not in config.SCAN_TIMEFRAMES]",
 "161": "    if bad_tf:",
 "162": "        return jsonify({\"error\": f\"Invalid timeframes: {bad_tf}\"}), 400",
 "163": "",
 "164": "    grids = None",
 "165": "    if custom_grids:",
 "166": "        grids, err = _validate_custom_grids(custom_grids)",
 "167": "        if err:",
 "168": "            return jsonify({",
 "169": "                \"error\": err,",
 "170": "                \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "171": "            }), 400",
 "172": "",
 "173": "    # Объём скана (symbols × timeframes × Σ combos) считаем до старта:",
 "174": "    # UI показывает масштаб — сколько всего комбинаций будет прогнано.",
 "175": "    total_combinations = scanner_mod.plan_totals(",
 "176": "        symbols, strategies, grids=grids, timeframes=timeframes)",
 "177": "    if total_combinations > config.SCAN_MAX_COMBINATIONS:",
 "178": "        return jsonify({",
 "179": "            \"error\": (f\"Too many combinations: {total_combinations} > \"",
 "180": "                      f\"{config.SCAN_MAX_COMBINATIONS}. \"",
 "181": "                      \"Сократите символы, ТФ или стратегии.\"),",
 "182": "            \"total_combinations\": total_combinations,",
 "183": "            \"total_symbols\": len(symbols),",
 "184": "            \"total_timeframes\": len(timeframes),",
 "185": "            \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "186": "        }), 400",
 "187": "",
 "188": "    estimated_seconds = _estimate_seconds(",
 "189": "        total_combinations, len(symbols), len(timeframes))",
 "190": "    if estimated_seconds > config.SCAN_HARD_LIMIT_SECONDS:",
 "191": "        return jsonify({",
 "192": "            \"error\": (f\"Too long: прогон займёт \"",
 "193": "                      f\"{_human_seconds(estimated_seconds)} > 4 часов. \"",
 "194": "                      \"Сократите объём или запустите по частям.\"),",
 "195": "            \"estimated_seconds\": estimated_seconds,",
 "196": "            \"estimated_human\": _human_seconds(estimated_seconds),",
 "197": "            \"total_combinations\": total_combinations,",
 "198": "            \"total_symbols\": len(symbols),",
 "199": "            \"total_timeframes\": len(timeframes),",
 "200": "            \"max_combinations\": config.SCAN_MAX_COMBINATIONS,",
 "201": "            \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "202": "        }), 400",
 "203": "",
 "204": "    warning = None",
 "205": "    if estimated_seconds > config.SCAN_WARN_SECONDS:",
 "206": "        warning = (f\"Прогон займёт {_human_seconds(estimated_seconds)} \"",
 "207": "                   f\"(больше 30 минут). Продолжить?\")",
 "208": "",
 "209": "    run_id = uuid.uuid4().hex",
 "210": "",
 "211": "    def _bg():",
 "212": "        try:",
 "213": "            scanner_mod.run_scan(",
 "214": "                symbols, timeframes, strategies,",
 "215": "                run_id=run_id, grids=grids)",
 "216": "        except Exception:  # noqa: BLE001",
 "217": "            log.exception(\"scan run %s failed\", run_id)",
 "218": "",
 "219": "    threading.Thread(target=_bg, daemon=True,",
 "220": "                     name=f\"scan-{run_id[:8]}\").start()",
 "221": "    payload = {",
 "222": "        \"run_id\": run_id, \"status\": \"started\",",
 "223": "        \"total_combinations\": total_combinations,",
 "224": "        \"estimated_seconds\": estimated_seconds,",
 "225": "        \"estimated_human\": _human_seconds(estimated_seconds),",
 "226": "        \"total_symbols\": len(symbols),",
 "227": "        \"total_timeframes\": len(timeframes),",
 "228": "        \"warn_seconds\": config.SCAN_WARN_SECONDS,",
 "229": "        \"hard_limit_seconds\": config.SCAN_HARD_LIMIT_SECONDS,",
 "230": "        \"filtered_count\": scanner_mod.get_run_stats(run_id).get(\"filtered\", 0),",
 "231": "    }",
 "232": "    if warning:",
 "233": "        payload[\"warning\"] = warning",
 "234": "    return jsonify(payload)",
 "235": "",
 "236": "",
